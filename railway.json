{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "dockerfile",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "numReplicas": 1,
    "restartPolicyType": "on_failure",
    "restartPolicyMaxRetries": 3,
    "healthchecks": {
      "liveness": {
        "httpGet": {
          "path": "/health",
          "port": 8000
        },
        "initialDelaySeconds": 30,
        "periodSeconds": 10
      }
    }
  }
}
